# Copy this file to .env and pick ONE provider. Never commit .env (it is in .gitignore).

# --- Option 1: local AI with Ollama (free, private, no key). Default. ---
# Run: docker compose --profile local-ai up -d --build
AI_PROVIDER=Ollama
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.2:3b
AI_API_KEY=

# --- Option 2: Google Gemini (free tier, key from https://aistudio.google.com/apikey) ---
# AI_PROVIDER=Gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash        # check the provider docs for current model names
# AI_API_KEY=your-key-here

# --- Option 3: Groq (free tier, fast, key from https://console.groq.com/keys) ---
# AI_PROVIDER=Groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=your-key-here

# --- Option 4: OpenAI ---
# AI_PROVIDER=OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=your-key-here
